{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aven",
  "version": "1.2.1",
  "identifier": "app.aven.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aven",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#16161D"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost data: blob:; worker-src 'self' blob:; frame-src https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Aven",
    "copyright": "Copyright (c) 2026 Aven",
    "category": "Productivity",
    "shortDescription": "Visual thinking workspace",
    "longDescription": "Aven is a local-first desktop visual thinking workspace: an infinite canvas, projects, templates and exports to Obsidian, Notion and Google Drive.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "aven"
        ],
        "name": "Aven drawing",
        "description": "Aven drawing",
        "role": "Editor",
        "mimeType": "application/vnd.aven+json"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "French"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  },
  "plugins": {}
}